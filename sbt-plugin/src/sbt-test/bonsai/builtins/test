# RemoveUnused runs without a .scalafix.conf, the compiler is asked for the warnings, and inferred types are left out
> scalafixAll --check
> listed RemoveUnused
> unlisted ExplicitResultTypes
> flagged -Wunused:all
# an unused import fails the check, though fatal warnings would fail the compile on it
> set ThisBuild / scalacOptions += "-Werror"
$ copy-file changes/Unused.scala src/main/scala/demo/Unused.scala
> compile
-> scalafixAll --check
# leaving the rule out drops the rule and the flag
> set ThisBuild / bonsaiDisabled += "RemoveUnused"
> unflagged -Wunused:all
> scalafixAll --check
> unlisted RemoveUnused
$ delete src/main/scala/demo/Unused.scala
# an inferred type of a public member fails the check once the opt-in rule is enabled, which PublicTypes reports alike
> set ThisBuild / bonsaiDisabled := Set("PublicTypes")
> set ThisBuild / bonsaiEnabledRules += "ExplicitResultTypes"
> scalafixAll --check
> listed ExplicitResultTypes
$ copy-file changes/Inferred.scala src/main/scala/demo/Inferred.scala
-> scalafixAll --check
> set ThisBuild / bonsaiDisabled += "ExplicitResultTypes"
> scalafixAll --check
> unlisted ExplicitResultTypes
# in relaxed mode the findings only warn
> set ThisBuild / bonsaiDisabled := Set("PublicTypes")
> set ThisBuild / bonsaiMode := BonsaiMode.Relaxed
> bonsaiScalafixCheck
> set ThisBuild / bonsaiMode := BonsaiMode.Strict
$ delete src/main/scala/demo/Inferred.scala
# a build that asks the compiler for unused warnings itself keeps its own options
> set ThisBuild / scalacOptions += "-Wunused:imports"
> unflagged -Wunused:all -Wconf:msg=^unused\s.*:i -Wconf:msg=^@nowarn\sannotation\s.*:i
> scalafixAll --check
# a line whose compiler scalafix cannot load leaves ExplicitResultTypes out rather than breaking the build
> set ThisBuild / scalaVersion := "3.4.3"
> set ThisBuild / bonsaiDisabled := Set("PublicTypes")
$ copy-file changes/Inferred.scala src/main/scala/demo/Inferred.scala
> scalafixAll --check
> unlisted ExplicitResultTypes
> listed RemoveUnused
# only the opt-in rules can be enabled
-> set ThisBuild / bonsaiEnabledRules := Set("RemoveUnused")
