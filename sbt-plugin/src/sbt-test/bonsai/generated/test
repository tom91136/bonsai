# what a build generates, in its managed source directory or elsewhere, is generated code, which no rule reports
> bonsaiAnalyse
# a source written by hand is reported all the same
$ copy-file changes/Spare.scala src/main/scala/demo/Spare.scala
-> bonsaiAnalyse
# the compiler plugin skips generated code too, so the managed source compiles in ci mode
> compile
# a hand-written copy of the same code fails the compile in ci mode
$ copy-file changes/Hand.scala src/main/scala/demo/Hand.scala
-> compile
